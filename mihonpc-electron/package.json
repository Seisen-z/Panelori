{
  "name": "mihonpc-electron",
  "version": "1.2.2",
  "description": "MihonPC desktop manga reader \u00e2\u20ac\u201d Electron rewrite",
  "main": "./out/main/index.js",
  "author": "MihonPC contributors",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "check": "npm run typecheck && npm run lint",
    "test": "node scripts/test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:extensions": "node scripts/extensions.mjs",
    "test:flow": "node scripts/flow.mjs",
    "test:packaged": "node scripts/flow.mjs --packaged",
    "test:runtime": "node scripts/runtime-flow.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "zustand": "^5.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "@types/better-sqlite3": "^7.6.0",
    "esbuild": "^0.27.0"
  },
  "license": "Apache-2.0"
}
